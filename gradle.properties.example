useLocalJTransientBuild=false
useLocalJPlateSolveBuild=false

# Optional reference data for the release smoke tests (realDataSmokeTest).
# Use forward slashes on Windows; keep the actual path in git-ignored gradle.properties.
# realDataRoot=<reference dataset folder>

# Optional Windows installer build: WiX 3 folder containing candle.exe and light.exe.
# wixHome=<WiX tools folder>
